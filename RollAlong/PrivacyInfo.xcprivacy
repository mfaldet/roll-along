<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Roll Along does NOT track.  The app never shows the App Tracking
         Transparency prompt, never reads the advertising identifier, and
         every ad request is non-personalised (AdManager: npa=1) with teen
         age treatment.  No data is linked with third-party data for
         advertising and nothing is shared with data brokers.
         The Google Mobile Ads SDK ships its own privacy manifest for what
         the SDK itself collects; this file covers the app's own code. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No tracking, so no tracking domains. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- What the app's own code sends off the device (all to the app's
         Supabase backend).  Two groups:
           A. ANONYMOUS analytics — keyed to a random per-install id, never
              to the account.  Not linked.
           B. SIGNED-IN social data — only after the player chooses Sign in
              with Apple.  Linked to the account, used to run the feature. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>

        <!-- A. Random per-install UUID (ra_analytics_user_id), created on
             first launch.  Groups analytics events and anonymous trophy
             unlocks by install.  Not the advertising identifier. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- A. Gameplay events: level start/win/fail, minigame rounds and
             scores, challenge-track and daily-challenge progress, trophy
             unlocks (also the anonymous trophy rarity counts). -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeGameplayContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- A. Product interaction: app launch/resume, screens and purchase
             sheets opened, buttons tapped, cosmetics equipped. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- A. Advertising data: which steps of a rewarded ad happened
             (loaded, started, reward earned, dismissed, failed).  No ad
             content and no advertising identifier. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeAdvertisingData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- A. Purchase events: in-app purchase started / completed /
             cancelled / failed with the product id and displayed price, and
             coin purchases of cosmetics.  No payment details. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- A. Device model ("iPhone17,1"), iOS version and app version,
             attached to every analytics event. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>

        <!-- B. Account identifier: the Supabase user id created when the
             player signs in with Apple.  The app does not request the
             player's name or email address. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- B. Signed-in game data stored against the account and shown to
             other players: the preset nickname, climb level, stars, minigame
             bests and wins (leaderboards), clan membership, friends, life
             gifts, and unlocked trophies / public trophy showcase.  Removed
             by Settings → Delete Account. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeGameplayContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

    </array>

    <!-- Required-reason API declarations. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>

        <!-- UserDefaults holds the player's own save: progress, settings,
             owned cosmetics, lives, coins, purchase flags and the analytics
             install id.  Reason CA92.1: read/write information accessible
             only to the app itself. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>

    </array>
</dict>
</plist>
